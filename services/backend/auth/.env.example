# PulseExpends Auth Service Configuration
# Copy this file to .env and fill in the values

# Database - connects to pulseexpends_auth logical DB on the shared RDS instance
DATABASE_URL=postgresql://pulseexpends_admin:CHANGE_ME@10.0.1.137:5432/pulseexpends_auth

# JWT Configuration
JWT_SECRET=change-me-to-a-secure-random-string

# Cookie Configuration
COOKIE_SECRET=change-me-to-a-secure-random-string
COOKIE_SECURE=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://pulseexpends.duckdns.org/api/auth/google/callback

# Frontend URL for CORS
FRONTEND_URL=http://pulseexpends.duckdns.org
CORS_ALLOWED_ORIGINS=http://pulseexpends.duckdns.org,http://182.160.24.205

# Server
PORT=8082
