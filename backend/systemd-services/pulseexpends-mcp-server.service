[Unit]
Description=PulseExpends MCP Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/PulseExpends
ExecStart=/usr/local/go/bin/go run /opt/PulseExpends/mcp-server-enhanced.go
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target