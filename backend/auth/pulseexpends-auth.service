[Unit]
Description=PulseExpends Authentication Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/PulseExpends/backend/auth
EnvironmentFile=/opt/PulseExpends/backend/auth/.env
ExecStart=/opt/PulseExpends/backend/auth/auth-server
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pulseexpends-auth

# Security
ProtectSystem=strict
ReadWritePaths=/opt/PulseExpends/backend/auth/logs
PrivateTmp=true
NoNewPrivileges=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target