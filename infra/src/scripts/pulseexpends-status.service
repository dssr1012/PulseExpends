[Unit]
Description=PulseExpends Status Dashboard
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/PulseExpends/infra/dashboard
ExecStart=/usr/bin/python3 /opt/PulseExpends/infra/dashboard/serve-dashboard.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/PulseExpends/infra/dashboard
ReadOnlyPaths=/

[Install]
WantedBy=multi-user.target