# Huawei Cloud Credentials
# ========================
# RENOMBRAR ESTE ARCHIVO A terraform.tfvars Y AGREGAR TUS CREDENCIALES REALES
# NUNCA COMMITEAR terraform.tfvars AL REPOSITORIO PÚBLICO
# USAR VARIABLES DE ENTORNO O SISTEMA DE SECRETS EN PRODUCCIÓN

# Credenciales de Huawei Cloud (OBLIGATORIAS)
access_key = "TU_ACCESS_KEY_AQUI"
secret_key = "TU_SECRET_KEY_AQUI"
project_id = "TU_PROJECT_ID_AQUI"

# Configuración de región
region = "la-south-2"  # Santiago, Chile

# Configuración de instancia ECS
instance_type = "c6.large.2"
availability_zone = "la-south-2a"
image_id = "your-image-id"  # Ubuntu 22.04 recommended
vpc_id = "your-vpc-id"
subnet_id = "your-subnet-id"
security_group_id = "your-security-group-id"
key_pair_name = "pulse-expends-key-ed25519"  # Nombre del key pair en Huawei Cloud

# Configuración de almacenamiento
system_disk_type = "SSD"
system_disk_size = 40  # GB
data_disk_type = "SSD"
data_disk_size = 100   # GB

# Configuración RDS (opcional - habilitar solo si necesitas base de datos gestionada)
enable_rds = false
rds_instance_type = "rds.pg.c2.medium"
rds_storage = 100
rds_username = "pulseexpends_admin"
rds_password = "CONTRASEÑA_SEGURA_AQUI_MÍNIMO_16_CARACTERES"
rds_availability_zone = "la-south-2a"

# Configuración de red
eip_bandwidth_size = 5  # Mbps
eip_charge_mode = "traffic"  # "traffic" or "bandwidth"

# Tags para recursos
tags = {
  Project     = "PulseExpends"
  Environment = "development"
  Owner       = "InfrastructureTeam"
  CostCenter  = "Engineering"
}

# Configuración de nombres
instance_name = "pulseexpends-dev-ecs"
rds_instance_name = "pulseexpends-dev-rds"
vpc_name = "pulseexpends-vpc"
subnet_name = "pulseexpends-subnet"
security_group_name = "pulseexpends-sg"

# Configuración de puertos a abrir
open_ports = [
  22,   # SSH
  80,   # HTTP
  443,  # HTTPS
  8080, # MCP Server
  8081, # Status Dashboard
  8082, # Auth API
  8083, # Main API
  8000, # PDF Parser
  5432, # PostgreSQL (solo interno)
]

# Configuración de usuario
admin_username = "ubuntu"
admin_password = ""  # Dejar vacío si usas solo SSH key

# Enterprise Project (opcional - solo si usas Huawei Cloud Enterprise)
enterprise_project_id = ""

# Auto-scaling (opcional)
enable_auto_scaling = false
min_instance_count = 1
max_instance_count = 3
cool_down_time = 300  # seconds
cpu_utilization_threshold = 70  # percentage

# Monitoring (opcional)
enable_monitoring = true
monitoring_interval = 300  # seconds
alarm_actions = []  # Lista de URLs para notificaciones

# Backup (opcional)
enable_backup = false
backup_frequency = "daily"
backup_retention_days = 7

# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a terraform.tfvars: cp terraform.tfvars.example terraform.tfvars
# 2. Edita terraform.tfvars con tus credenciales REALES
# 3. NUNCA commitees terraform.tfvars al repositorio
# 4. Agrega terraform.tfvars a .gitignore
# 5. Usa variables de entorno en CI/CD: 
#    export TF_VAR_access_key="tu_access_key"
#    export TF_VAR_secret_key="tu_secret_key"
#    export TF_VAR_project_id="tu_project_id"
# ============================================================================