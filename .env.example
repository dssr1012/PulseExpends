# ============================================================================
# PulseExpends - Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment
# ============================================================================

# Server Configuration
SERVER_ADDRESS=:8080
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=
SERVER_TLS_KEY_FILE=
SERVER_ALLOWED_ORIGINS=*
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Storage Configuration
STORAGE_TYPE=obs  # 'obs' for Phase 1, 'postgres' for Phase 2

# Huawei Cloud OBS Configuration (Phase 1)
OBS_ENDPOINT=https://obs.la-south-2.myhuaweicloud.com
OBS_ACCESS_KEY_ID=your-access-key-id
OBS_SECRET_ACCESS_KEY=your-secret-access-key
OBS_BUCKET_NAME=pulse-expends
OBS_REGION=la-south-2
OBS_ENCRYPTION_KEY=your-encryption-key-32-bytes

# PostgreSQL Configuration (Phase 2)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulseexpends
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=pulseexpends
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MAX_IDLE=25

# Python PDF Parser Service
PYTHON_SERVICE_URL=http://localhost:8000

# JWT Configuration
JWT_SECRET=change-this-in-production-secret-key
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168
JWT_ISSUER=pulse-expends
JWT_AUDIENCE=pulse-expends-users

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0

# OpenAI Configuration (for AI parsing)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# PDF Parser Configuration
PDF_PARSER_API_KEY=your-pdf-parser-api-key
TESSERACT_PATH=/usr/bin/tesseract
DEFAULT_LANGUAGE=spa+eng
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=50
MAX_CONCURRENT_PROCESSES=4
PROCESSING_TIMEOUT_SECONDS=300

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_STACK_TRACE=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@pulseexpends.com

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Feature Flags
FEATURE_AI_PARSING=true
FEATURE_REALTIME_UPDATES=true
FEATURE_BUDGET_ALERTS=true
FEATURE_MULTI_CURRENCY=false
FEATURE_TAX_REPORTING=false

# Development Settings
DEBUG=false
ENVIRONMENT=development
ALLOW_INSECURE_CONNECTIONS=false

# ============================================================================
# Deployment Specific (Huawei Cloud)
# ============================================================================

# Huawei Cloud IAM
HUAWEICLOUD_ACCESS_KEY_ID=your-huaweicloud-access-key-id
HUAWEICLOUD_SECRET_ACCESS_KEY=your-huaweicloud-secret-access-key
HUAWEICLOUD_PROJECT_ID=your-project-id
HUAWEICLOUD_REGION=la-south-2

# Huawei Cloud Services
HUAWEICLOUD_OBS_ENDPOINT=https://obs.la-south-2.myhuaweicloud.com
HUAWEICLOUD_RDS_ENDPOINT=https://rds.la-south-2.myhuaweicloud.com
HUAWEICLOUD_ECS_ENDPOINT=https://ecs.la-south-2.myhuaweicloud.com
HUAWEICLOUD_VPC_ENDPOINT=https://vpc.la-south-2.myhuaweicloud.com

# ============================================================================
# Security
# ============================================================================

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_ALLOW_CREDENTIALS=true

# API Keys
ADMIN_API_KEY=your-admin-api-key
INTERNAL_API_KEY=your-internal-api-key

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-bytes
ENCRYPTION_ALGORITHM=AES-256-GCM

# ============================================================================
# Third Party Integrations
# ============================================================================

# Plaid (Bank connections)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENVIRONMENT=sandbox

# Stripe (Payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid (Email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@pulseexpends.com

# ============================================================================
# Application Settings
# ============================================================================

# Default Currency
DEFAULT_CURRENCY=CLP

# Supported Currencies
SUPPORTED_CURRENCIES=CLP,USD,EUR,GBP,JPY,CNY

# Date Format
DATE_FORMAT=DD/MM/YYYY

# Time Zone
TIME_ZONE=America/Santiago

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# Cache Settings
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=100

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.jpg,.jpeg,.png,.tiff,.tif,.bmp

# Session Settings
SESSION_TIMEOUT_MINUTES=30
SESSION_REFRESH_ENABLED=true

# ============================================================================
# Development Overrides
# ============================================================================

# Uncomment for development
# DEBUG=true
# ENVIRONMENT=development
# ALLOW_INSECURE_CONNECTIONS=true
# LOG_LEVEL=debug
# SERVER_ADDRESS=:3000