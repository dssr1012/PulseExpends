# ============================================
# PulseExpends - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ============================================

# ====================
# Application Settings
# ====================

# Application
NODE_ENV=development
APP_NAME=PulseExpends
APP_VERSION=0.1.0
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
AI_ENGINE_URL=http://localhost:3002

# ====================
# Database
# ====================

# PostgreSQL
DATABASE_URL=postgresql://pulse:pulsepassword@localhost:5432/pulse_expends
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulse_expends
DB_USER=pulse
DB_PASSWORD=pulsepassword
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====================
# Authentication & Security
# ====================

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Password
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# ====================
# AI & ML Services
# ====================

# OpenClaw Integration
OPENCLAW_API_KEY=your-openclaw-api-key
OPENCLAW_BASE_URL=https://api.openclaw.ai
OPENCLAW_MODEL=deepseek-v3.2

# OCR Services
TESSERACT_LANG=eng
TESSERACT_PATH=/usr/share/tesseract-ocr/4.00/tessdata

# Machine Learning
ML_MODEL_PATH=./models
ML_TRAINING_DATA=./data/training
ML_PREDICTION_THRESHOLD=0.8

# ====================
# External APIs
# ====================

# Banking APIs (Example - configure as needed)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENVIRONMENT=sandbox

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@pulseexpends.com

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=pulse-expends-files
AWS_BUCKET_URL=https://pulse-expends-files.s3.amazonaws.com

# ====================
# Monitoring & Logging
# ====================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
SENTRY_DSN=your-sentry-dsn

# ====================
# Feature Flags
# ====================

# Enable/Disable Features
FEATURE_AI_CATEGORIZATION=true
FEATURE_RECEIPT_OCR=true
FEATURE_BANK_SYNC=false
FEATURE_MULTI_CURRENCY=true
FEATURE_TAX_REPORTING=false
FEATURE_INVESTMENT_TRACKING=false

# ====================
# Development
# ====================

# Debug
DEBUG=app:*
DEBUG_LEVEL=info

# Testing
TEST_DATABASE_URL=postgresql://test:testpassword@localhost:5432/pulse_expends_test
TEST_REDIS_URL=redis://localhost:6380

# ====================
# Production Overrides
# ====================

# Uncomment for production
# NODE_ENV=production
# APP_URL=https://app.pulseexpends.com
# FRONTEND_URL=https://app.pulseexpends.com
# DATABASE_URL=postgresql://user:password@production-db:5432/pulse_expends_prod
# REDIS_URL=redis://production-redis:6379
# JWT_SECRET=change-this-to-a-strong-secret-in-production
# CORS_ORIGIN=https://app.pulseexpends.com
# LOG_LEVEL=warn